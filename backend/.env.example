# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://saathi:saathi_pass@localhost:5432/migrant_saathi
SYNC_DATABASE_URL=postgresql://saathi:saathi_pass@localhost:5432/migrant_saathi

# === REDIS ===
REDIS_URL=redis://localhost:6379/0

# === JWT ===
SECRET_KEY=change-this-to-a-random-64-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === IBM watsonx.ai ===
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# === OTP (set false to require real email/SMS delivery) ===
OTP_MOCK_MODE=false
OTP_EXPIRE_MINUTES=10

# Gmail: use an App Password, not your login password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Live phone OTP — configure at least one SMS provider
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === APP ===
APP_NAME=Migrant Saathi AI
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
